{
  "name": "qyl-mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "qyl telemetry MCP Apps server: interactive trace explorer + MCP dashboard, live against the qyl collector with demo fallback",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANcpLua/qyl.mcp",
    "directory": "server"
  },
  "license": "MIT",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "qyl-mcp-server": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build --mode mcp-app && vite build --mode mcp-dashboard && tsc -p tsconfig.server.json",
    "smoke": "node smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": { "node": ">=22" }
}
