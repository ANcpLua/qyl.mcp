{
  "name": "qyl-mcp-workbench",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Authenticated local MCP workbench with connection inspection, evaluation, and in-process qyl telemetry tools",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "test": "bun run build && bun run test:built",
    "smoke": "node smoke.mjs",
    "start": "node dist/main.js",
    "smoke:otlp": "node telemetry-smoke.mjs",
    "test:built": "node --test --test-concurrency=4 dist/src/*.test.js"
  },
  "dependencies": {
    "@ancplua/qyl-api-schema": "14.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.3.0",
    "qyl-mcp-server": "11.1.4",
    "zod": "4.6.5",
    "@ancplua/qyl-semantic-conventions": "15.0.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "hono": "4.13.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
