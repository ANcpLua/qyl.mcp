{
  "name": "qyl-mcp-workbench",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Authenticated local MCP workbench with connection inspection, evaluation, and in-process qyl telemetry tools",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "test": "bun run build && node --test dist/src/*.test.js",
    "smoke": "node smoke.mjs",
    "start": "node dist/main.js",
    "smoke:otlp": "node telemetry-smoke.mjs"
  },
  "dependencies": {
    "@ancplua/qyl-api-schema": "11.2.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "express": "5.2.1",
    "qyl-mcp-server": "7.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "hono": "4.13.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
