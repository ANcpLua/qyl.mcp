{
  "name": "qyl.mcp",
  "private": true,
  "type": "module",
  "description": "qyl MCP server: telemetry analysis tools for agents",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build": "bun run --cwd server build",
    "test": "bun install --frozen-lockfile && bun run build && bun run test:built",
    "start": "bun server/dist/main.js",
    "smoke": "bun run --cwd server smoke",
    "smoke:live": "bun run --cwd server smoke:live",
    "verify:pins": "node verify-contract-pins.mjs",
    "verify:sdk": "node --test scripts/verify-mcp-sdk.test.mjs && bun scripts/verify-mcp-sdk.mjs",
    "lint": "oxlint .",
    "smoke:projects": "bun run --cwd server smoke:projects",
    "test:built": "bun run --cwd server test:built"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2"
  }
}
